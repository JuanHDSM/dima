@inherits LayoutComponentBase

<MudThemeProvider 
    @ref="_mudThemeProvider"
    @bind-IsDarkMode="_isDarkMode" 
    Theme="Configuration.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
                <a href="/" style="color: white; font-weight: bold;">Finux</a>
                <MudSpacer />
                <MudText Typo="Typo.caption">
                    @context.User.Identity?.Name
                </MudText>
                <MudSwitch 
                    Color="Color.Inherit" 
                    @bind-Value="@_isDarkMode" 
                    T="bool"
                    Class="ma-4"
                    ThumbIcon="@Icons.Material.TwoTone.Lightbulb"
                />

            </MudAppBar>
            <MudDrawer @bind-Open="@_isDrawerOpend" ClipMode="DrawerClipMode.Always">
                <NavMenu />
            </MudDrawer>
            <MudMainContent>
                <MudContainer Class="mt-4">
                    @Body
                    <MudFab Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Add"
                            Style="position: fixed; bottom: 20px; right: 20px; z-index: 1000;" 
                            Href="/entry/create"/>
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <LoginRedirect />
    </NotAuthorized>
</AuthorizeView>

@code {

    private bool _isDrawerOpend = false;
    private bool _isDarkMode = false;
    private MudThemeProvider _mudThemeProvider = null!;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemPreference();
            await _mudThemeProvider.WatchSystemPreference(OnSystemPreferenceChanged);
            StateHasChanged();
        }
    }
    private Task OnSystemPreferenceChanged(bool newValue)
    {
        _isDarkMode = newValue;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ToggleDrawer()
        => _isDrawerOpend = !_isDrawerOpend;
}