@page "/entry/create"
@using Transaction = System.Transactions.Transaction
@inherits CreateTransactionPage

<MudText Typo="Typo.h3">Lançamentos</MudText>

<MudPaper Class="pa-8 mt-4">
    <EditForm Model="@InputModel" OnValidSubmit="OnValidSubmitAsync">
        <DataAnnotationsValidator />
        <MudTextField 
            Label="Título" 
            HelperText="Campo obrigatório" 
            @bind-Value="InputModel.Title"
            For="@(() => InputModel.Title)" />

        <MudTextField 
            Label="Quanto" 
            Format="C"
            T="decimal"
            Variant="Variant.Text"
            HelperText="Informe o valor da transação" 
            @bind-Value="InputModel.Amount"
            For="@(() => InputModel.Amount)" />

        <MudDatePicker 
            Label="Quando" @bind-Date="@InputModel.PaidOrReceivedAt"
            HelperText="Selecione a data que o valor será pago ou recebido" />

        <MudSelect 
            T="ETransactionType" 
            Label="Tipo de movimentação" 
            AnchorOrigin="Origin.BottomCenter"
            @bind-Value="InputModel.Type"
            >
    
            <MudSelectItem T="ETransactionType" Value="ETransactionType.Deposit">
                Entrada
            </MudSelectItem>
            
            <MudSelectItem T="ETransactionType" Value="ETransactionType.Withdraw">
                Saída
            </MudSelectItem>
        </MudSelect> 

        <MudSelect 
            T="long" 
            Label="Categoria" 
            Class="py-4"
            AnchorOrigin="Origin.BottomCenter"
            @bind-Value="InputModel.CategoryId">

            @foreach (var category in Categories)
            {
                <MudSelectItem T="long" Value="category.Id">
                    @category.Title
                </MudSelectItem>
            }
        </MudSelect>
        
        <MudText>Recorrência</MudText>
        <MudSwitch Label="Recorrência" @bind-Value="IsRecurring" Color="Color.Primary" />
        
        @if (!IsRecurring)
        {
            
        }
        else
        {
            <MudSelect
                T="ERecurringType?"
                Label="Recorrência"
                AnchorOrigin="Origin.BottomCenter"
                @bind-Value="InputModel.RecurringType">
                <MudSelectItem T="ERecurringType?" Value="ERecurringType.MonthlyFixed">
                    Mensalmente
                </MudSelectItem>
                <MudSelectItem T="ERecurringType?" Value="ERecurringType.Customized">
                    Parcelar ou Repetir
                </MudSelectItem>
            </MudSelect>
            
            @if (InputModel.RecurringType == ERecurringType.Customized)
            {
                <MudNumericField
                    Class="py-4"
                    T="int"
                    Label="Quantidade de parcelas"
                    @bind-Value="InputModel.Installments" />
                
                <MudSelect
                    T="EInstallmentsType"
                    Class="py-4"
                    AnchorOrigin="Origin.BottomCenter"
                    Label="Tipo"
                    @bind-Value="InputModel.InstallmentsType">

                    <MudSelectItem T="EInstallmentsType"
                                   Value="@EInstallmentsType.Daily">
                        Diário
                    </MudSelectItem>
                        
                    <MudSelectItem T="EInstallmentsType"
                                   Value="@EInstallmentsType.Weekly">
                        Semanal
                    </MudSelectItem>

                    <MudSelectItem T="EInstallmentsType"
                                   Value="@EInstallmentsType.Monthly">
                        Mensal
                    </MudSelectItem>
                        
                    <MudSelectItem T="EInstallmentsType"
                                   Value="@EInstallmentsType.Quarterly">
                        Trimestral
                    </MudSelectItem>
                        
                    <MudSelectItem T="EInstallmentsType"
                                   Value="@EInstallmentsType.Yearly">
                        Anual
                    </MudSelectItem>

                </MudSelect>
                
                <MudToggleGroup T="string" SelectionMode="SelectionMode.SingleSelection" @bind-Value="_value1" Color="Color.Primary" CheckMark FixedContent>
                    <MudToggleItem Value="@("total_values")" Text="Valor Total" />
                    <MudToggleItem Value="@("installments_value")" Text="Valor da Parcela" />
                </MudToggleGroup>
                
                <MudText>Em @($"{InputModel.Installments}X") de: @(_value1 == "total_values" ? $"{InputModel.Amount / InputModel.Installments:F2}" : $"{InputModel.Amount:F2}")</MudText>
            }
        }

        <MudButton 
            ButtonType="ButtonType.Submit" 
            Variant="Variant.Filled" 
            Color="Color.Primary" 
            Class="mt-4">
            Salvar
        </MudButton>
    </EditForm>
</MudPaper>